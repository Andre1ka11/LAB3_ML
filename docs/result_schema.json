{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One real LLM response; no reference answers in requests",
  "type": "object",
  "required": ["run_id", "task_id", "experiment", "language", "model_id", "provider", "timestamp_utc", "bank_version", "bank_sha256", "prompt_sha256", "temperature_requested", "temperature_effective", "thinking_mode", "raw_response", "input_tokens", "output_tokens", "latency_s", "error"],
  "properties": {
    "task_id": {"type": "string"},
    "experiment": {"enum": ["main", "pilot", "classification", "hypothesis"]},
    "language": {"enum": ["ru", "en"]},
    "model_id": {"type": "string"},
    "shots": {"enum": [0, 5, 20]},
    "row_id": {"type": "string"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "latency_s": {"type": "number", "minimum": 0},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"experiment": {"const": "classification"}}}, "then": {"required": ["shots", "row_id"]}}
  ]
}
